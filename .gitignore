# local dev only — app/index.html is the deployable build
test.html
test-old.html
*.jpg
# ...except the screenshots the shell page ships with (app/ is the deployed bundle)
!app/shots/*.jpg
relay/node_modules/

# Blender unit forge: sources and scratch renders stay local.
# app/sprites/ IS deployed (the game fetches it) so it is NOT ignored.
blender/sheets/
blender/blends/
blender/out*/
blender/roster.png
spr-*.png

# CI test harness
node_modules/
blender/btmp/
blender/bsheets/
blender/sheets-hd/
blender/hd-render.log
blender/hd-render.err

# app-store shells: keystores and generated projects stay local
app-shell/*.keystore
app-shell/app/
app-shell/build/
app-shell/*.log
app-shell/capacitor/node_modules/
app-shell/capacitor/www/
app-shell/capacitor/ios/
app-shell/capacitor/android/
